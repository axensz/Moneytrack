rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidAmount(amount) {
      return amount is number && amount > 0 && amount <= 1000000000;
    }

    function isValidString(str, minLength, maxLength) {
      return str is string && str.size() >= minLength && str.size() <= maxLength;
    }

    // Las operaciones coordinadas de cuentas consultan varias colecciones antes
    // de confirmar un único batch. El lease usa request.time del servidor; así
    // un reloj de dispositivo desajustado no puede crear un lock ya vencido.
    function accountOperationLockIsActive(data) {
      return 'accountOperationLock' in data.keys()
        && data.accountOperationLock is map
        && !('releasedAt' in data.accountOperationLock.keys())
        && (
          (
            'acquiredAt' in data.accountOperationLock.keys()
            && data.accountOperationLock.acquiredAt is timestamp
            && data.accountOperationLock.acquiredAt + duration.value(5, 'm') > request.time
          )
          // Compatibilidad temporal con locks creados por versiones anteriores.
          || (
            !('acquiredAt' in data.accountOperationLock.keys())
            && 'expiresAt' in data.accountOperationLock.keys()
            && data.accountOperationLock.expiresAt is timestamp
            && data.accountOperationLock.expiresAt > request.time
          )
        );
    }

    function isValidAccountOperationLock(lock) {
      return lock is map
        && lock.keys().hasOnly(['id', 'kind', 'acquiredAt'])
        && lock.id is string
        && lock.id.size() > 0
        && lock.id.size() <= 200
        && lock.kind in [
          'delete-account',
          'merge-credit-cards',
          'set-default-account',
          'delete-debt',
          'reassign-debt-account',
          'ledger-mutation'
        ]
        && lock.acquiredAt is timestamp
        && lock.acquiredAt == request.time;
    }

    function isValidAccountOperationRelease(nextLock, previousLock) {
      return nextLock is map
        && previousLock is map
        && nextLock.keys().hasOnly(['id', 'kind', 'releasedAt'])
        && nextLock.id == previousLock.id
        && nextLock.kind == previousLock.kind
        && nextLock.releasedAt is timestamp
        && nextLock.releasedAt == request.time;
    }

    function accountOperationRootUpdateAllowed() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let nextHasLock = 'accountOperationLock' in request.resource.data.keys();
      let previousHasLock = 'accountOperationLock' in resource.data.keys();
      return changedKeys.hasOnly(['accountOperationLock'])
        && nextHasLock
        && (
          (
            isValidAccountOperationLock(request.resource.data.accountOperationLock)
            && (
              (
                accountOperationLockIsActive(resource.data)
                && previousHasLock
                && request.resource.data.accountOperationLock.id
                  == resource.data.accountOperationLock.id
              )
              || (
                !accountOperationLockIsActive(resource.data)
                && (
                  !previousHasLock
                  || request.resource.data.accountOperationLock.id
                    != resource.data.accountOperationLock.id
                )
              )
            )
          )
          // El commit final deja un tombstone con el mismo id. Un batch viejo
          // no puede liberar un lease más nuevo adquirido tras su expiración.
          || (
            previousHasLock
            && accountOperationLockIsActive(resource.data)
            && isValidAccountOperationRelease(
              request.resource.data.accountOperationLock,
              resource.data.accountOperationLock
            )
          )
        );
    }

    function accountOperationAllowsWrite(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return !existsAfter(userPath)
        || !accountOperationLockIsActive(getAfter(userPath).data);
    }

    function accountExistsAfter(userId, accountId) {
      return accountId is string
        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/accounts/$(accountId)
        );
    }

    function isValidLast4(value) {
      return value is string && value.matches('[0-9]{4}');
    }

    function isValidPaymentInstrument(userId, data) {
      return data.keys().hasOnly([
          'schemaVersion',
          'label',
          'accountId',
          'kind',
          'last4',
          'network',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'schemaVersion',
          'label',
          'accountId',
          'kind',
          'network',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.schemaVersion in [1, 2]
        && isValidString(data.label, 1, 80)
        && accountExistsAfter(userId, data.accountId)
        && data.kind in ['physical-card', 'wallet-token']
        && (
          (
            data.schemaVersion == 1
            && 'last4' in data.keys()
            && isValidLast4(data.last4)
          )
          || (
            data.schemaVersion == 2
            && (
              (
                data.kind == 'physical-card'
                && 'last4' in data.keys()
                && isValidLast4(data.last4)
              )
              || (
                data.kind == 'wallet-token'
                && (
                  !('last4' in data.keys())
                  || isValidLast4(data.last4)
                )
              )
            )
          )
        )
        && data.network in ['visa', 'mastercard', 'amex', 'other', 'unknown']
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransactionImportCandidateBase(candidateId, data) {
      return candidateId.matches('[a-f0-9]{64}')
        && data.keys().hasOnly([
          'schemaVersion',
          'source',
          'sourcePackage',
          'occurredAt',
          'amountMinor',
          'currency',
          'merchant',
          'cardLast4',
          'observedInstrumentLabel',
          'parserId',
          'parserVersion',
          'confidence',
          'status',
          'transactionId',
          'confirmedAt',
          'dismissedAt'
        ])
        && data.keys().hasAll([
          'schemaVersion',
          'source',
          'sourcePackage',
          'occurredAt',
          'amountMinor',
          'currency',
          'merchant',
          'parserId',
          'parserVersion',
          'confidence',
          'status'
        ])
        && data.schemaVersion in [1, 2]
        && data.source == 'android-notification'
        && isValidString(data.sourcePackage, 1, 160)
        && data.occurredAt is timestamp
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 100000000000
        && data.currency == 'COP'
        && isValidString(data.merchant, 1, 140)
        && (
          !('cardLast4' in data.keys())
          || isValidLast4(data.cardLast4)
        )
        && (
          (
            data.schemaVersion == 1
            && data.parserId == 'strict-cop-purchase'
            && !('observedInstrumentLabel' in data.keys())
          )
          || (
            data.schemaVersion == 2
            && data.sourcePackage == 'com.google.android.apps.walletnfcrel'
            && data.parserId == 'google-wallet-purchase'
            && (
              !('observedInstrumentLabel' in data.keys())
              || isValidString(data.observedInstrumentLabel, 1, 24)
            )
          )
        )
        && data.parserVersion == 1
        && data.confidence in ['high', 'medium']
        && data.status in ['pending', 'confirmed', 'dismissed'];
    }

    function isValidTransactionImportCandidateState(candidateId, data) {
      return isValidTransactionImportCandidateBase(candidateId, data)
        && (
          (
            data.status == 'pending'
            && !('transactionId' in data.keys())
            && !('confirmedAt' in data.keys())
            && !('dismissedAt' in data.keys())
          )
          || (
            data.status == 'confirmed'
            && isValidString(data.transactionId, 1, 200)
            && data.confirmedAt is timestamp
            && !('dismissedAt' in data.keys())
          )
          || (
            data.status == 'dismissed'
            && data.dismissedAt is timestamp
            && !('transactionId' in data.keys())
            && !('confirmedAt' in data.keys())
          )
        );
    }

    function transactionImportCandidateNoOp(candidateId) {
      return isValidTransactionImportCandidateState(
          candidateId,
          request.resource.data
        )
        && request.resource.data.diff(resource.data).affectedKeys().size() == 0;
    }

    function transactionImportCandidateDismissAllowed(candidateId) {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'dismissed'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'dismissedAt'])
        && isValidTransactionImportCandidateState(
          candidateId,
          request.resource.data
        )
        && request.resource.data.dismissedAt == request.time;
    }

    function transactionImportCandidateConfirmationAllowed(
      userId,
      candidateId
    ) {
      let operationId = 'ledger-mutation:android:' + candidateId;
      let userPath = /databases/$(database)/documents/users/$(userId);
      let transactionPath = /databases/$(database)/documents/users/$(userId)/transactions/$(operationId);
      return resource.data.status == 'pending'
        && request.resource.data.status == 'confirmed'
        && request.resource.data.transactionId == operationId
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'transactionId', 'confirmedAt'])
        && isValidTransactionImportCandidateState(
          candidateId,
          request.resource.data
        )
        && exists(userPath)
        && accountOperationLockIsActive(get(userPath).data)
        && get(userPath).data.accountOperationLock.kind == 'ledger-mutation'
        && !exists(transactionPath)
        && existsAfter(transactionPath)
        && getAfter(transactionPath).data.operationId == operationId
        && getAfter(transactionPath).data.mutationKind == 'create'
        && getAfter(transactionPath).data.mutationSource == 'android'
        && isValidAccountOperationRelease(
          getAfter(userPath).data.accountOperationLock,
          get(userPath).data.accountOperationLock
        );
    }

    function hasValidCreditAuthority(data) {
      return data.type != 'credit'
        || (
          'usedCredit' in data.keys()
          && data.usedCredit is number
          && data.usedCredit >= 0
          && data.usedCredit <= 1000000000
        );
    }

    function hasValidTransferReferences(userId, data) {
      let sourcePath = /databases/$(database)/documents/users/$(userId)/accounts/$(data.accountId);
      return data.type != 'transfer'
        || (
          'toAccountId' in data.keys()
          && data.toAccountId is string
          && data.toAccountId != data.accountId
          && accountExistsAfter(userId, data.accountId)
          && accountExistsAfter(userId, data.toAccountId)
          && getAfter(sourcePath).data.type != 'credit'
        );
    }

    function debtExistsAfter(userId, debtId) {
      return debtId is string
        && existsAfter(
          /databases/$(database)/documents/users/$(userId)/debts/$(debtId)
        );
    }

    function hasValidOptionalAccountReference(userId, data, field) {
      return !(field in data.keys())
        || accountExistsAfter(userId, data[field]);
    }

    function updatedAccountReferenceIsValid(userId, field) {
      return request.resource.data.get(field, null)
          == resource.data.get(field, null)
        || hasValidOptionalAccountReference(
          userId,
          request.resource.data,
          field
        );
    }

    function hasValidOptionalDebtReference(userId, data) {
      return !('debtId' in data.keys())
        || debtExistsAfter(userId, data.debtId);
    }

    function updatedDebtReferenceIsValid(userId) {
      return request.resource.data.get('debtId', null)
          == resource.data.get('debtId', null)
        || hasValidOptionalDebtReference(userId, request.resource.data);
    }

    // Helper: validate optional installment fields on transactions
    function hasValidInstallments(data) {
      // If no installments field, it's a regular transaction — valid
      return !('installments' in data.keys()) || (
        data.installments is int
        && data.installments >= 1
        && data.installments <= 36
      );
    }

    function hasValidInterestFields(data) {
      // Optional fields: only validate if present
      return (!('totalInterestAmount' in data.keys()) || (data.totalInterestAmount is number && data.totalInterestAmount >= 0))
        && (!('monthlyInstallmentAmount' in data.keys()) || (data.monthlyInstallmentAmount is number && data.monthlyInstallmentAmount > 0))
        && (!('interestRate' in data.keys()) || (data.interestRate is number && data.interestRate >= 0 && data.interestRate <= 200));
    }

    // Helper: validate optional multi-currency fields on transactions
    function hasValidCurrencyFields(data) {
      return (!('currency' in data.keys()) || data.currency is string)
        && (!('originalCurrency' in data.keys()) || data.originalCurrency is string)
        && (!('originalAmount' in data.keys()) || (data.originalAmount is number && data.originalAmount > 0))
        && (!('exchangeRate' in data.keys()) || (data.exchangeRate is number && data.exchangeRate > 0));
    }

    // Helper: validate optional payment mapping fields on debts/loans
    function hasValidDebtPaymentSchedule(data) {
      return (!('expectedPaymentDay' in data.keys())
              || (data.expectedPaymentDay is int
                  && data.expectedPaymentDay >= 1
                  && data.expectedPaymentDay <= 31))
        && (!('nextPaymentDate' in data.keys())
              || data.nextPaymentDate is timestamp);
    }

    // User data collections
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['accountOperationLock'])
        && isValidAccountOperationLock(
          request.resource.data.accountOperationLock
        );
      allow update: if isOwner(userId)
        && accountOperationRootUpdateAllowed();
      allow delete: if isOwner(userId)
        && !accountOperationLockIsActive(resource.data);

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if isOwner(userId);

        // Description is optional but if provided must be valid
        allow create: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && request.resource.data.type in ['income', 'expense', 'transfer']
          && isValidAmount(request.resource.data.amount)
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.category is string
          && request.resource.data.paid is bool
          && request.resource.data.accountId is string
          && accountExistsAfter(userId, request.resource.data.accountId)
          && hasValidOptionalAccountReference(
            userId,
            request.resource.data,
            'toAccountId'
          )
          && hasValidTransferReferences(userId, request.resource.data)
          && hasValidOptionalDebtReference(userId, request.resource.data)
          && request.resource.data.date is timestamp
          && request.resource.data.createdAt is timestamp
          && hasValidInstallments(request.resource.data)
          && hasValidInterestFields(request.resource.data)
          && hasValidCurrencyFields(request.resource.data);

        // AUDIT-FIX (#30): update endurecido para espejar la validación de create.
        // La app hace updates PARCIALES (togglear paid, editar amount/date/category/
        // description, mover accountId en merge de TC, sincronizar cuotas/intereses).
        // Como Firestore fusiona, request.resource.data SIEMPRE contiene el doc
        // completo, así que validar los campos siempre presentes no rompe updates
        // parciales: los campos no tocados conservan su valor previo (ya válido).
        // Reglas:
        //  - type es inmutable (no se puede cambiar income/expense/transfer).
        //  - accountId string (puede cambiar en merge de TC).
        //  - amount number > 0 y dentro de rango (isValidAmount).
        //  - description string <= 500 (se permite vacía intencionalmente, fix #17).
        //  - category string (igual que create: no exige no-vacío para no bloquear
        //    docs heredados ni los updates parciales que no tocan category).
        //  - date timestamp.
        //  - paid bool.
        //  - cuotas, intereses y multimoneda: si están presentes, dentro de rango.
        allow update: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && request.resource.data.type == resource.data.type
          && request.resource.data.accountId is string
          && updatedAccountReferenceIsValid(userId, 'accountId')
          && updatedAccountReferenceIsValid(userId, 'toAccountId')
          && hasValidTransferReferences(userId, request.resource.data)
          && updatedDebtReferenceIsValid(userId)
          && isValidAmount(request.resource.data.amount)
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.category is string
          && request.resource.data.date is timestamp
          && request.resource.data.paid is bool
          && hasValidInstallments(request.resource.data)
          && hasValidInterestFields(request.resource.data)
          && hasValidCurrencyFields(request.resource.data);

        allow delete: if isOwner(userId)
          && accountOperationAllowsWrite(userId);
      }

      // Accounts subcollection
      match /accounts/{accountId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type in ['savings', 'credit', 'cash']
          && request.resource.data.isDefault is bool
          && request.resource.data.initialBalance is number
          && request.resource.data.initialBalance >= -1000000000
          && request.resource.data.initialBalance <= 1000000000
          && hasValidCreditAuthority(request.resource.data);

        // AUDIT-FIX: update valida que type sea inmutable y name sea válido
        allow update: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && request.resource.data.type == resource.data.type
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && hasValidCreditAuthority(request.resource.data);

        allow delete: if isOwner(userId)
          && accountOperationAllowsWrite(userId);
      }

      // Physical cards and wallet tokens point to an existing Account. They
      // never carry PAN/CVV/raw notification data because the shape is exact.
      match /paymentInstruments/{instrumentId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && isValidPaymentInstrument(userId, request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && isValidPaymentInstrument(userId, request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(userId)
          && accountOperationAllowsWrite(userId);
      }

      // Android writes only normalized, non-financial candidates. A candidate
      // can enter the ledger solely through the matching ledger lease, canonical
      // transaction and release in the same atomic commit.
      match /transactionImportCandidates/{candidateId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidTransactionImportCandidateState(
            candidateId,
            request.resource.data
          )
          && request.resource.data.status == 'pending';

        allow update: if isOwner(userId)
          && (
            transactionImportCandidateNoOp(candidateId)
            || transactionImportCandidateDismissAllowed(candidateId)
            || transactionImportCandidateConfirmationAllowed(
              userId,
              candidateId
            )
          );
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.type in ['expense', 'income']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;

        // AUDIT-FIX (#30): update endurecido (espeja create). La app actual solo
        // crea/borra categorías, pero validamos por si un restore/import escribe.
        //  - type inmutable y dentro del enum.
        //  - name string no vacío y <= 100.
        allow update: if isOwner(userId)
          && request.resource.data.type == resource.data.type
          && request.resource.data.type in ['expense', 'income']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
        allow delete: if isOwner(userId);
      }

      // Recurring payments subcollection
      match /recurringPayments/{paymentId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && isValidAmount(request.resource.data.amount)
          && request.resource.data.category is string
          && request.resource.data.dueDay is int
          && request.resource.data.dueDay >= 1
          && request.resource.data.dueDay <= 31
          && request.resource.data.frequency in ['monthly', 'yearly']
          && request.resource.data.isActive is bool
          && hasValidOptionalAccountReference(
            userId,
            request.resource.data,
            'accountId'
          )
          && request.resource.data.createdAt is timestamp;

        // AUDIT-FIX (#30): update endurecido (espeja create). La app hace updates
        // PARCIALES: { isActive } (pausar/reactivar), { amount } (sincronizar con
        // el pago real), edición completa por formulario, y al registrar un pago
        // puede fijar lastPaidDate / lastPaidAmount. Firestore fusiona, así que
        // request.resource.data tiene el doc completo: validar los campos siempre
        // presentes no rompe los updates parciales.
        //  - name string 1-200.
        //  - amount number > 0 y en rango (isValidAmount).
        //  - category string.
        //  - dueDay int 1-31.
        //  - frequency en ['monthly','yearly'].
        //  - isActive bool.
        //  - lastPaidDate (opcional): si está, timestamp.
        //  - lastPaidAmount (opcional): si está, number >= 0.
        allow update: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && isValidAmount(request.resource.data.amount)
          && request.resource.data.category is string
          && request.resource.data.dueDay is int
          && request.resource.data.dueDay >= 1
          && request.resource.data.dueDay <= 31
          && request.resource.data.frequency in ['monthly', 'yearly']
          && request.resource.data.isActive is bool
          && updatedAccountReferenceIsValid(userId, 'accountId')
          && (!('lastPaidDate' in request.resource.data.keys())
              || request.resource.data.lastPaidDate is timestamp)
          && (!('lastPaidAmount' in request.resource.data.keys())
              || (request.resource.data.lastPaidAmount is number
                  && request.resource.data.lastPaidAmount >= 0));
        allow delete: if isOwner(userId)
          && accountOperationAllowsWrite(userId);
      }

      // Debts / Loans subcollection
      match /debts/{debtId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && request.resource.data.personName is string
          && request.resource.data.personName.size() > 0
          && request.resource.data.personName.size() <= 200
          && request.resource.data.type in ['lent', 'borrowed']
          && isValidAmount(request.resource.data.originalAmount)
          && request.resource.data.remainingAmount is number
          && request.resource.data.remainingAmount >= 0
          && request.resource.data.remainingAmount <= request.resource.data.originalAmount
          && request.resource.data.isSettled is bool
          && request.resource.data.createdAt is timestamp
          && hasValidOptionalAccountReference(
            userId,
            request.resource.data,
            'accountId'
          )
          && hasValidDebtPaymentSchedule(request.resource.data);

        allow update: if isOwner(userId)
          && accountOperationAllowsWrite(userId)
          && request.resource.data.type == resource.data.type
          && request.resource.data.personName is string
          && request.resource.data.personName.size() > 0
          && isValidAmount(request.resource.data.originalAmount)
          && request.resource.data.remainingAmount is number
          && request.resource.data.remainingAmount >= 0
          && request.resource.data.remainingAmount <= request.resource.data.originalAmount
          && updatedAccountReferenceIsValid(userId, 'accountId')
          && hasValidDebtPaymentSchedule(request.resource.data);

        allow delete: if isOwner(userId)
          && accountOperationAllowsWrite(userId);
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() <= 100
          && isValidAmount(request.resource.data.monthlyLimit)
          && request.resource.data.isActive is bool
          && request.resource.data.createdAt is timestamp;

        allow update: if isOwner(userId)
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0;

        allow delete: if isOwner(userId);
      }

      // Savings Goals subcollection
      match /savingsGoals/{goalId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && isValidAmount(request.resource.data.targetAmount)
          && request.resource.data.currentAmount is number
          && request.resource.data.currentAmount >= 0
          && request.resource.data.isCompleted is bool
          && request.resource.data.createdAt is timestamp;

        allow update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.currentAmount is number
          && request.resource.data.currentAmount >= 0;

        allow delete: if isOwner(userId);
      }

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.type in ['budget', 'recurring', 'unusual_spending', 'low_balance', 'debt', 'info']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 500
          && request.resource.data.severity in ['info', 'warning', 'error', 'success']
          && request.resource.data.isRead is bool
          && request.resource.data.createdAt is timestamp;

        // AUDIT-FIX (#30): update endurecido (espeja create). En la práctica la app
        // solo hace { isRead: true } (marcar leída / marcar todas como leídas).
        // Firestore fusiona, así que request.resource.data tiene el doc completo;
        // validamos los campos siempre presentes sin romper el update parcial.
        //  - type inmutable y dentro del enum.
        //  - title string 1-200.
        //  - message string 1-500.
        //  - severity en el enum permitido.
        //  - isRead bool.
        allow update: if isOwner(userId)
          && request.resource.data.type == resource.data.type
          && request.resource.data.type in ['budget', 'recurring', 'unusual_spending', 'low_balance', 'debt', 'info']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 500
          && request.resource.data.severity in ['info', 'warning', 'error', 'success']
          && request.resource.data.isRead is bool;
        allow delete: if isOwner(userId);
      }

      // Notification Preferences document
      match /notificationPreferences/settings {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Ajustes del usuario. Validados ESTRICTAMENTE por documento; cualquier otro
      // settingId o campo desconocido se rechaza (default-deny). Audit S-settings-rule.
      // (Antes /settings/{settingId} aceptaba campos arbitrarios sin validar, p. ej.
      // un planConfig.declaredIncome NaN/negativo/enorme.)
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        // El dueño puede borrar cualquiera de sus docs de ajustes (clearConfig).
        allow delete: if isOwner(userId);

        // settings/ai — clave BYOK de Gemini + consentimiento de IA (escritura con merge).
        allow create, update: if isOwner(userId)
          && settingId == 'ai'
          && request.resource.data.keys().hasOnly(['geminiApiKey', 'aiConsent'])
          && (!('geminiApiKey' in request.resource.data.keys())
              || (request.resource.data.geminiApiKey is string
                  && request.resource.data.geminiApiKey.size() <= 200))
          && (!('aiConsent' in request.resource.data.keys())
              || request.resource.data.aiConsent is bool);

        // settings/planConfig — configuración del plan financiero.
        allow create, update: if isOwner(userId)
          && settingId == 'planConfig'
          && request.resource.data.keys().hasOnly(['startMonth', 'declaredIncome'])
          && request.resource.data.startMonth is string
          && request.resource.data.startMonth.matches('[0-9]{4}-[0-9]{2}')
          && isValidAmount(request.resource.data.declaredIncome);

        // settings/beneficiaries — lista editable de Personas / Beneficiarios.
        allow create, update: if isOwner(userId)
          && settingId == 'beneficiaries'
          && request.resource.data.keys().hasOnly(['items'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 50;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
