{
  "name": "moneytrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/inject-sw-version.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config vitest.config.mjs --configLoader runner",
    "test:run": "vitest run --config vitest.config.mjs --configLoader runner",
    "test:rules": "npx --yes firebase-tools@15.24.0 emulators:exec --only firestore --project demo-moneytrack \"npm run test:rules:run\"",
    "test:rules:run": "vitest run src/__tests__/firestore/accountOperationLock.rules.test.ts src/__tests__/firestore/transactionImport.rules.test.ts --no-file-parallelism --config vitest.config.mjs --configLoader runner",
    "prepare": "husky || exit 0",
    "test:coverage": "vitest run --config vitest.config.mjs --configLoader runner --coverage"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.7.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.25",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "fast-check": "^3.23.2",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1",
    "undici": "^7.28.0"
  }
}
